# Главная сцена «Обороны грядки».
# Прототипы (внутри Protos) — это префабы: их клонирует функция spawn().

[node]
name = Root
script = scripts/game.og

# Карта автора растянута как в оригинале: левая половина картинки —
# дорожка, правая — газон.
[node]
name = BGLeft
parent = Root
type = Sprite
sprite = map
x = 0
y = 0
w = 250
h = 720
sx = 0
sy = 0
sw = 250
sh = 500
z = -5

[node]
name = BGRight
parent = Root
type = Sprite
sprite = map
x = 250
y = 0
w = 1030
h = 720
sx = 250
sy = 0
sw = 250
sh = 500
z = -5

