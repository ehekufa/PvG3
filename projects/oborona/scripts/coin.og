# Монета подсолнуха: нажми, чтобы забрать (+25). Сама исчезнет.

var t = 0
var life = 14.0

func _ready():
    self.visible = true

func _process(dt):
    t += dt
    life -= dt
    if life <= 0:
        self.free()

func collect():
    get_node("/Root").collect_coin(self)

func _press(x, y):
    collect()
    return true
